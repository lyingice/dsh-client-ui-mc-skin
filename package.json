{
  "name": "dsh-client-ui-mc-skin",
  "version": "1.5.1",
  "description": "Minecraft Ore UI theme for the DeepSeek Harness Web client — the Bedrock Edition design language transplanted from ClastarStudio (2px near-black edges, inset top highlights, canvas #161616, panels #3c3c3c, Ore green #4c9a2a primary actions, green-bar selected tabs), pixel font, persistent toggles, and an optional Minecraft AE pixel font streamed on demand by the host half. · 为 DSH Web 客户端准备的 Minecraft Ore UI 主题：照搬 ClastarStudio 的 Ore UI 设计系统（2px 近黑硬边 + 顶部内高光、#161616 画布、#3c3c3c 面板、#4c9a2a 绿色主操作、选中标签页顶部绿条）、像素字体、可持久化的开关，以及可选的 Minecraft AE 像素字体。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "minecraft",
    "mc",
    "ore-ui",
    "minecraft-theme",
    "pixel-font",
    "deepseek-harness"
  ],
  "dependencies": {},
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "tools",
    "assets",
    "build.mjs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "verify:selectors": "node tools/verify-selectors.mjs",
    "check:build": "node build.mjs && git diff --exit-code -- lib",
    "test": "node build.mjs && git diff --exit-code -- lib"
  },
  "author": "lyingice",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyingice/dsh-client-ui-mc-skin.git"
  },
  "bugs": {
    "url": "https://github.com/lyingice/dsh-client-ui-mc-skin/issues"
  },
  "homepage": "https://github.com/lyingice/dsh-client-ui-mc-skin#readme",
  "engines": {
    "node": ">=18"
  }
}
